# theme = Nvim Dark
theme = Catppuccin Mocha

# spacing between lines
adjust-cell-height = 18%

copy-on-select = true

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# background-opacity = 0.995

font-family = JetBrainsMono NFM
# font-family = JetBrainsMono NFM Thin
font-size = 14
font-feature = -calt
font-feature = -dlig
font-feature = -liga

window-padding-x = 10

macos-auto-secure-input = false
macos-secure-input-indication = false
# macos-titlebar-style = tabs

working-directory = home
window-inherit-working-directory = false

### KEYBINDS
# keybind = global:§=toggle_quick_terminal
# Send Shift-Enter as Alt-Enter so multiline input works through tmux.
keybind = shift+enter=text:\x1b\r
